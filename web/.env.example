# Copy to .env.local — server-side only, never commit real values.
# Leave a value empty to fall back to MockSource for that feed.

# CoinMarketCap Pro API key
CMC_API_KEY=
# CMC_BASE_URL=https://pro-api.coinmarketcap.com

# BNB Smart Chain RPC (mainnet read-only is fine)
BSC_RPC_URL=https://bsc-dataseed.bnbchain.org

# Atlas Chainlink-compatible feed address per symbol (TBD — ask organizers)
ATLAS_FEED_ADDRESS_BNB=

# Optional LLM for the guarded agent's rationale
LLM_API_KEY=
